# Copy to .env.local and fill in. Never commit real values.
# Added by later tasks (Supabase, Stripe, email).

# Site origin for links in emails and Stripe return URLs. REQUIRED in production
# (e.g. https://www.efzinwellness.com); production never trusts the request's Host header.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Member sign-in (email link + Google). The anon key is public; never put the service role key here.
# Supabase Auth setup (see docs/setup-supabase.md):
# - keep "Confirm email" ON; disable email+password sign-up (passwordless links only)
# - redirect allow list: <origin>/account/auth/callback, <origin>/account/auth/confirm, <origin>/account
# - magic link email template links to <origin>/account/auth/confirm?token_hash={{ .TokenHash }}&type=email
# - enable the Google provider
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
