# Copy to .env.local and fill in. Never commit real values.
# Added by later tasks (Supabase, Stripe, email).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Member sign-in (email link + Google). The anon key is public; never put the service role key here.
# In Supabase Auth settings, add <origin>/account/auth/callback and <origin>/account to the redirect allow list
# and enable the Google provider.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
