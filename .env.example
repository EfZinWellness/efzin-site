# Copy to .env.local and fill in. Never commit real values.
# Every variable the code reads is listed here. docs/launch-runbook.md section A says where to find
# each value and which Vercel environment (Production / Preview) it goes in.

# --- Site ---------------------------------------------------------------------------------------
# Site origin for links in emails and Stripe return URLs. REQUIRED in production
# (e.g. https://www.efzinwellness.com); production never trusts the request's Host header.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# --- Supabase (one project for staging, a separate one for production) ---------------------------
# Member sign-in (email link + Google). The anon key is public; never put the service role key here.
# Supabase Auth setup (see docs/setup-supabase.md):
# - keep "Confirm email" ON; disable email+password sign-up (passwordless links only)
# - redirect allow list: <origin>/account/auth/callback, <origin>/account/auth/confirm, <origin>/account
# - magic link email template links to <origin>/account/auth/confirm?token_hash={{ .TokenHash }}&type=email
# - enable the Google provider
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to create member accounts after payment. Never expose the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for the same project (Supabase > Connect > Transaction pooler or Direct).
# Server only. Also used by npm run sync:content and the import / cancel scripts.
DATABASE_URL=

# --- Stripe (sk_test_ keys in staging/Preview, sk_live_ only in Production) ----------------------
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint for THIS environment (starts with whsec_).
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ------------------------------------------------------------------------------
RESEND_API_KEY=
# Comma-separated addresses that get admin alerts AND may open /admin (e.g. contact@efzinwellness.com).
ADMIN_EMAILS=

# --- Scheduled jobs ------------------------------------------------------------------------------
# Long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to the cron jobs in
# vercel.json; the jobs answer 401 without it.
CRON_SECRET=

# --- Staging only (leave unset in Production) ----------------------------------------------------
# Attach new Stripe customers to a test clock (made by scripts/stripe-test-clock.ts). Test keys only.
# STRIPE_TEST_CLOCK_ID=

# Staging end-to-end test (npm run test:e2e:staging). Uses STRIPE_SECRET_KEY (sk_test_ only),
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from above, pointed at the STAGING project.
# E2E_STAGING_URL=https://<your-preview-address>.vercel.app
# EFZIN_E2E_ADMIN_EMAIL=contact@efzinwellness.com
# E2E_STAGING_SLUG=<slug of an experience that is on sale on staging>
# E2E_STAGING_SOLDOUT_SLUG=

# --- Local development / automated tests only (never set on Vercel) ------------------------------
# EFZIN_FAKE_USD_RATES={"GBP":0.79,"EUR":0.92}
# EFZIN_EXTRA_CONTENT_DIR=tests/e2e/fixtures
# EFZIN_TEST_AUTH_EMAIL=e2e@example.com
# EFZIN_FAKE_BOOKING_STATUS={}
